# .env.example
# Create a copy of this file as .env and fill in the values

# Optional: Set paths for SAR model checkpoints
FINETUNED_MODEL_PATH=""
DECUR_CHECKPOINT=""

# Optional: Set paths for EO model checkpoints
# Note: DECUR_CHECKPOINT_EO can point at the SAME joint DeCUR checkpoint file 
# as DECUR_CHECKPOINT if it contains both backbone_1 and backbone_2.
# The loader will select by modality regardless of which file is passed.
FINETUNED_MODEL_PATH_EO=""
DECUR_CHECKPOINT_EO=""
